<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ccb</groupId>
        <artifactId>techfin-platform-ai</artifactId>
        <version>1.0.0.RELEASE</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>techfin-service</artifactId>
    <name>techfin-service</name>
    <description>业务逻辑层：Service 接口与实现、配置、校验器</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.ccb</groupId>
            <artifactId>techfin-dao</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccb</groupId>
            <artifactId>techfin-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ccb</groupId>
            <artifactId>techfin-common</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Apache POI for Word document generation -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <!-- Apache HttpClient 5：外部平台（DIB）调用 RestClient 的底层传输实现，
             提供可配置连接池（PoolingHttpClientConnectionManager）。版本由 spring-boot-dependencies 管理。
             注意：JDK HttpClient 虽也有内部连接池，但池大小不可配，无法满足「池容量可控」的要求。 -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>

        <!-- Spring AI：OpenAI 兼容协议，走官方 starter 自动装配。
             由 spring.ai.openai.* 配置驱动，自动产出 OpenAiApi / ChatModel / ChatClient.Builder，
             不再手工构建实例。api-key 必填（Spring AI 启动时校验，留空直接启动失败）。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
