# Lombok 全局配置（项目根，作用于所有子模块）
# 不再向上查找父目录的 lombok.config
config.stopBubbling = true

# 把字段上的 @Qualifier 复制到 @RequiredArgsConstructor 生成的构造器参数上。
# 必须配置：Lombok 默认不会复制该注解，缺失时两个同类型 bean（fileRestTemplate / apiRestTemplate）
# 会无法被 Spring 区分，启动报 NoUniqueBeanDefinitionException。
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
